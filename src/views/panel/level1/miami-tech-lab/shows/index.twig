{% extends "templates/base.admin.twig" %}{% block page_title %}Miami Tech Lab Shows{% endblock %}{% block body %}
<div class="container-fluid py-4"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1 class="h3 mb-1">Miami Tech Lab Shows</h1><p class="text-muted mb-0">Manage shows, episodes, guests, transcripts and recording schedules for <code>miamitechlab</code>.</p></div><a class="btn btn-outline-primary" href="{{ path('shows') }}" target="_blank">Open public shows</a></div>
{% if warning %}<div class="alert alert-warning">{{ warning }}</div>{% endif %}
<ul class="nav nav-tabs" role="tablist">{% for key,label in {'show':'Shows','episode':'Episodes & transcripts','guest':'Guests','recording':'Recording schedule'} %}<li class="nav-item"><button class="nav-link {{ loop.first?'active':'' }}" data-bs-toggle="tab" data-bs-target="#{{ key }}">{{ label }}</button></li>{% endfor %}</ul>
<div class="tab-content bg-white border border-top-0 rounded-bottom p-4 mb-4">
<div class="tab-pane fade show active" id="show"><form method="post" class="row g-3"><input type="hidden" name="record_type" value="show"><div class="col-md-6"><label class="form-label">Title *</label><input class="form-control" name="title" required></div><div class="col-md-6"><label class="form-label">Slug</label><input class="form-control" name="slug" placeholder="generated-from-title"></div><div class="col-12"><label class="form-label">Tagline</label><input class="form-control" name="tagline"></div><div class="col-12"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="4"></textarea></div><div class="col-md-6"><label class="form-label">Cover image URL</label><input class="form-control" name="cover_image_url" type="url"></div><div class="col-md-3"><label class="form-label">Status</label><select class="form-select" name="status"><option>DRAFT</option><option>PUBLISHED</option><option>ARCHIVED</option></select></div><div class="col-md-3"><label class="form-label">Publish at</label><input class="form-control" name="published_at" type="datetime-local"></div><div><button class="btn btn-primary">Create show</button></div></form></div>
<div class="tab-pane fade" id="episode"><form method="post" class="row g-3"><input type="hidden" name="record_type" value="episode"><div class="col-md-4"><label class="form-label">Show *</label><select class="form-select" name="show_id" required><option value="">Choose</option>{% for item in shows %}<option value="{{ item.id }}">{{ item.title }}</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label">Guest</label><select class="form-select" name="guest_id"><option value="">None</option>{% for item in guests %}<option value="{{ item.id }}">{{ item.name }}</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label">Episode number</label><input class="form-control" name="episode_number" type="number" min="1"></div><div class="col-md-8"><label class="form-label">Title *</label><input class="form-control" name="title" required></div><div class="col-md-4"><label class="form-label">Slug</label><input class="form-control" name="slug"></div><div class="col-12"><label class="form-label">Summary</label><textarea class="form-control" name="summary" rows="3"></textarea></div><div class="col-md-6"><label class="form-label">Media URL</label><input class="form-control" name="media_url" type="url"></div><div class="col-md-6"><label class="form-label">Thumbnail URL</label><input class="form-control" name="thumbnail_url" type="url"></div><div class="col-12"><label class="form-label">Transcript</label><textarea class="form-control" name="transcript_text" rows="7"></textarea></div><div class="col-md-4"><label class="form-label">Transcript status</label><select class="form-select" name="transcript_status"><option>NONE</option><option>DRAFT</option><option>REVIEWED</option><option>PUBLISHED</option></select></div><div class="col-md-4"><label class="form-label">Episode status</label><select class="form-select" name="status"><option>DRAFT</option><option>SCHEDULED</option><option>PUBLISHED</option><option>ARCHIVED</option></select></div><div class="col-md-4"><label class="form-label">Publish at</label><input class="form-control" name="published_at" type="datetime-local"></div><div><button class="btn btn-primary">Create episode</button></div></form></div>
<div class="tab-pane fade" id="guest"><form method="post" class="row g-3"><input type="hidden" name="record_type" value="guest"><div class="col-md-4"><label class="form-label">Show *</label><select class="form-select" name="show_id" required>{% for item in shows %}<option value="{{ item.id }}">{{ item.title }}</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label">Name *</label><input class="form-control" name="name" required></div><div class="col-md-4"><label class="form-label">Role</label><input class="form-control" name="role_title"></div><div class="col-md-6"><label class="form-label">Company</label><input class="form-control" name="company"></div><div class="col-md-6"><label class="form-label">Profile URL</label><input class="form-control" name="profile_url" type="url"></div><div class="col-12"><label class="form-label">Bio</label><textarea class="form-control" name="bio" rows="4"></textarea></div><div class="col-md-6"><label class="form-label">Photo URL</label><input class="form-control" name="photo_url" type="url"></div><div class="col-md-3 form-check mt-5"><input class="form-check-input" type="checkbox" name="is_published" value="1" id="guest-live"><label class="form-check-label" for="guest-live">Published</label></div><div><button class="btn btn-primary">Create guest</button></div></form></div>
<div class="tab-pane fade" id="recording"><form method="post" class="row g-3"><input type="hidden" name="record_type" value="recording"><div class="col-md-4"><label class="form-label">Show *</label><select class="form-select" name="show_id" required>{% for item in shows %}<option value="{{ item.id }}">{{ item.title }}</option>{% endfor %}</select></div><div class="col-md-8"><label class="form-label">Title *</label><input class="form-control" name="title" required></div><div class="col-md-4"><label class="form-label">Starts *</label><input class="form-control" name="starts_at" type="datetime-local" required></div><div class="col-md-4"><label class="form-label">Ends</label><input class="form-control" name="ends_at" type="datetime-local"></div><div class="col-md-4"><label class="form-label">Access</label><select class="form-select" name="access_level"><option>PUBLIC</option><option>COMMUNITY</option><option>PRIVATE</option><option>PREMIUM</option><option>PARTNER</option></select></div><div class="col-md-6"><label class="form-label">Location</label><input class="form-control" name="location_name"></div><div class="col-md-6"><label class="form-label">Address</label><input class="form-control" name="location_address"></div><input type="hidden" name="timezone" value="America/New_York"><input type="hidden" name="status" value="PLANNED"><div><button class="btn btn-primary">Schedule recording</button></div></form></div></div>
<div class="card"><div class="card-header"><strong>Current content</strong></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Type</th><th>Title / name</th><th>Status</th><th>Schedule</th></tr></thead><tbody>{% for item in shows %}<tr><td>Show</td><td>{{ item.title }}</td><td>{{ item.status }}</td><td>{{ item.published_at }}</td></tr>{% endfor %}{% for item in episodes %}<tr><td>Episode</td><td>{{ item.title }}</td><td>{{ item.status }} · transcript {{ item.transcript_status }}</td><td>{{ item.published_at }}</td></tr>{% endfor %}{% for item in guests %}<tr><td>Guest</td><td>{{ item.name }}</td><td>{{ item.is_published?'Published':'Draft' }}</td><td>—</td></tr>{% endfor %}{% for item in recordings %}<tr><td>Recording</td><td>{{ item.title }}</td><td>{{ item.status }} · {{ item.access_level }}</td><td>{{ item.starts_at }}</td></tr>{% endfor %}{% if not shows and not episodes and not guests and not recordings %}<tr><td colspan="4" class="text-center text-muted py-4">No Miami Tech Lab show content yet.</td></tr>{% endif %}</tbody></table></div></div></div>
{% endblock %}
