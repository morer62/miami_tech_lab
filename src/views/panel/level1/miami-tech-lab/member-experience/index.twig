{% extends 'templates/base.admin.twig' %}{% block body %}{% set csrf = get_csrf() %}<main class="container-fluid py-4"><h1 class="h2">Tech Lab member experience</h1><p class="text-muted">Publish events to the isolated member dashboard and review member activity.</p><div class="card mb-4"><div class="card-header"><strong>Upcoming event catalog</strong></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Event</th><th>Date</th><th>Member status</th><th>Publish</th></tr></thead><tbody>{% for e in events %}<tr><td>{{ e.name }}<br><small>{{ e.venue_name }}</small></td><td>{{ e.start_date }}</td><td>{{ e.tech_status ?: 'Not included' }}</td><td><form method="post" class="d-flex gap-2"><input type="hidden" name="csrf_token" value="{{ csrf }}"><input type="hidden" name="action" value="event"><input type="hidden" name="event_id" value="{{ e.id }}"><input class="form-control" style="max-width:110px" type="number" min="1" name="capacity" value="{{ e.capacity }}" placeholder="Capacity"><select class="form-select" style="max-width:150px" name="status"><option>DRAFT</option><option {{ e.tech_status=='PUBLISHED'?'selected' }}>PUBLISHED</option><option {{ e.tech_status=='CANCELLED'?'selected' }}>CANCELLED</option></select><button class="btn btn-primary">Save</button></form></td></tr>{% else %}<tr><td colspan="4">No future Level 1 events are available.</td></tr>{% endfor %}</tbody></table></div></div><div class="row g-4"><div class="col-xl-7"><div class="card"><div class="card-header"><strong>Submitted requests</strong></div><div class="table-responsive"><table class="table"><thead><tr><th>Member</th><th>Type</th><th>Status</th><th>Submitted</th></tr></thead><tbody>{% for r in requests %}<tr><td>{{ r.name }} {{ r.lastname }}<br><small>{{ r.email }}</small></td><td>{{ r.request_type }}</td><td><form method="post" class="d-flex gap-2"><input type="hidden" name="csrf_token" value="{{ csrf }}"><input type="hidden" name="action" value="request"><input type="hidden" name="request_id" value="{{ r.id }}"><select name="status" class="form-select"><option {{ r.status=='SUBMITTED'?'selected' }}>SUBMITTED</option><option {{ r.status=='IN_REVIEW'?'selected' }}>IN_REVIEW</option><option {{ r.status=='CONTACTED'?'selected' }}>CONTACTED</option><option {{ r.status=='CLOSED'?'selected' }}>CLOSED</option></select><button class="btn btn-outline-primary">Update</button></form></td><td>{{ r.submitted_at }}</td></tr>{% else %}<tr><td colspan="4">No submitted requests.</td></tr>{% endfor %}</tbody></table></div></div></div><div class="col-xl-5"><div class="card"><div class="card-header"><strong>Members</strong></div><div class="table-responsive"><table class="table"><thead><tr><th>Member</th><th>Ophyra</th></tr></thead><tbody>{% for m in members %}<tr><td>{{ m.name }} {{ m.lastname }}<br><small>{{ m.email }}</small></td><td>{{ m.entitlement_status ?: 'Not granted' }}<br><small>{{ m.expires_at }}</small></td></tr>{% else %}<tr><td colspan="2">No members yet.</td></tr>{% endfor %}</tbody></table></div></div></div></div><div class="card mt-4"><div class="card-header"><strong>Featured member articles</strong></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Article</th><th>Feature</th></tr></thead><tbody>{% for a in articles %}<tr><td>{{ a.title }}<br><small>/blog/{{ a.slug }}</small></td><td><form method="post" class="d-flex gap-2"><input type="hidden" name="csrf_token" value="{{ csrf }}"><input type="hidden" name="action" value="featured"><input type="hidden" name="content_id" value="{{ a.id }}"><label class="form-check"><input class="form-check-input" type="checkbox" name="is_active" {{ a.is_featured ? 'checked' }}> Featured</label><input class="form-control" style="max-width:90px" type="number" name="sort_order" min="1" value="{{ a.sort_order }}"><button class="btn btn-outline-primary">Save</button></form></td></tr>{% endfor %}</tbody></table></div></div></main>{% endblock %}
