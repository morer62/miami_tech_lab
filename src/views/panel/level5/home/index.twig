{% extends 'templates/base.admin.twig' %}
{% block page_title %}My Tech Lab | Tech Lab Miami{% endblock %}
{% block body %}
<main class="tlm-home"><style>
.tlm-home{--ink:#070b18;--navy:#0c1230;--cyan:#02d7ea;--violet:#6d4aff;min-height:100vh;padding:28px;background:#f4f6fb;color:#111936}.tlm-shell{max-width:1240px;margin:auto}.tlm-hero{position:relative;overflow:hidden;padding:clamp(26px,5vw,58px);border-radius:30px;background:radial-gradient(circle at 82% 10%,rgba(109,74,255,.48),transparent 34%),radial-gradient(circle at 70% 80%,rgba(2,215,234,.22),transparent 35%),linear-gradient(135deg,var(--ink),var(--navy));color:#fff;box-shadow:0 28px 70px rgba(7,11,24,.2)}.tlm-kicker{color:var(--cyan);font-size:12px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.tlm-hero h1{max-width:760px;margin:16px 0 12px;color:#fff;font:800 clamp(34px,5vw,62px)/1.02 Manrope,system-ui;letter-spacing:-.045em}.tlm-hero p{max-width:680px;color:#cbd4ea;font-size:17px;line-height:1.75}.tlm-actions{display:flex;flex-wrap:wrap;gap:11px;margin-top:24px}.tlm-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 18px;border:1px solid rgba(255,255,255,.17);border-radius:999px;background:rgba(255,255,255,.06);color:#fff!important;font-size:12px;font-weight:900;letter-spacing:.08em;text-decoration:none;text-transform:uppercase}.tlm-btn.primary{border:0;background:linear-gradient(135deg,var(--cyan),#78eff8);color:#071018!important}.tlm-btn.violet{border:0;background:var(--violet)}.tlm-status{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:28px}.tlm-stat{padding:17px;border:1px solid rgba(255,255,255,.1);border-radius:18px;background:rgba(4,7,18,.5);text-decoration:none}.tlm-stat strong{display:block;color:#fff;font:800 26px Manrope}.tlm-stat span{display:block;margin-top:7px;color:#93a2c5;font-size:11px;font-weight:800;text-transform:uppercase}.tlm-section{margin-top:28px}.tlm-head{margin-bottom:14px}.tlm-head h2{margin:0;font:800 clamp(23px,3vw,34px) Manrope}.tlm-head p{margin:6px 0;color:#68738d}.tlm-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.tlm-card{display:flex;min-height:205px;flex-direction:column;padding:22px;border:1px solid #e2e6f0;border-radius:22px;background:#fff;box-shadow:0 14px 40px rgba(20,29,59,.07)}.tlm-card i{color:#087d89;font-size:23px}.tlm-card h3{margin:20px 0 7px;font:800 19px Manrope}.tlm-card p{margin:0 0 18px;color:#68738d;line-height:1.6}.tlm-card a,.tlm-link{margin-top:auto;color:#4d38c8;font-weight:800;text-decoration:none}.tlm-two{display:grid;grid-template-columns:1.2fr .8fr;gap:16px}.tlm-panel{overflow:hidden;border:1px solid #e2e6f0;border-radius:22px;background:#fff}.tlm-panel-head,.tlm-row{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:18px 20px;border-bottom:1px solid #edf0f6}.tlm-row span{display:block;color:#73809a;font-size:13px}.tlm-empty{padding:25px;color:#73809a}.tlm-callout{padding:24px;border-radius:22px;background:linear-gradient(135deg,#111936,#27205a);color:#fff}.tlm-callout h3{margin:15px 0 8px;color:#fff;font:800 25px Manrope}.tlm-callout p{color:#c8d1e8;line-height:1.7}@media(max-width:950px){.tlm-status,.tlm-grid{grid-template-columns:repeat(2,1fr)}.tlm-two{grid-template-columns:1fr}}@media(max-width:620px){.tlm-home{padding:15px}.tlm-status,.tlm-grid{grid-template-columns:1fr}.tlm-row{align-items:flex-start;flex-direction:column}.tlm-actions .tlm-btn{width:100%}}
</style><div class="tlm-shell">
<section class="tlm-hero"><span class="tlm-kicker"><i class="fa-solid fa-bolt"></i> Member workspace</span><h1>Welcome back{% if user.name is defined and user.name %}, {{ user.name }}{% endif %}. Build what matters next.</h1><p>Your Tech Lab Miami hub brings together practical technology, upcoming conversations, useful resources and people who know how to execute.</p><div class="tlm-actions"><a class="tlm-btn primary" href="{{ path('events') }}">Upcoming events</a><a class="tlm-btn violet" href="{{ path('shows') }}">Latest episodes</a><a class="tlm-btn" href="{{ path('resources') }}">Open resources</a></div><div class="tlm-status"><a class="tlm-stat" href="{{ path('events') }}"><strong>{{ stats.upcoming_events }}</strong><span>Upcoming activities</span></a><a class="tlm-stat" href="{{ path('panel/planner-hub/orders/orders') }}"><strong>{{ stats.orders }}</strong><span>Projects & proposals</span></a><a class="tlm-stat" href="{{ path('software') }}"><strong>4</strong><span>Featured tools</span></a><a class="tlm-stat" href="{{ path('resources') }}"><strong>24/7</strong><span>Resource access</span></a></div></section>
<section class="tlm-section"><div class="tlm-head"><h2>Your community hub</h2><p>Start with the outcome you need—not another feed to scroll.</p></div><div class="tlm-grid">
{% set cards=[['fa-handshake-angle','Request technology support','Tell us where a system, workflow or technology decision is slowing your business down.','support','Describe the challenge'],['fa-microphone-lines','Get featured','Propose a founder story, product, lesson or operational problem for a future conversation.','speakers','Pitch a story or guest'],['fa-people-group','Offer your expertise','Contribute a workshop, office hour or resource when you have useful experience to share.','partners','Become a contributor'],['fa-robot','AI for business','Explore responsible, practical uses of AI for service, operations, marketing and decisions.','blog','Read the latest insights'],['fa-gears','Automation & software','Find focused tools and workflow patterns that remove repetitive work without adding chaos.','software','Explore software'],['fa-location-dot','South Florida network','Discover locally relevant technology guidance across Miami-Dade, Broward and Palm Beach.','locations','Browse locations']] %}
{% for card in cards %}<article class="tlm-card"><i class="fa-solid {{ card[0] }}"></i><h3>{{ card[1] }}</h3><p>{{ card[2] }}</p><a href="{{ path(card[3]) }}">{{ card[4] }} →</a></article>{% endfor %}</div></section>
<section class="tlm-section tlm-two"><div class="tlm-panel"><div class="tlm-panel-head"><h3>Upcoming activity</h3><a class="tlm-link" href="{{ path('events') }}">View calendar</a></div>{% for order in upcomingEvents %}<div class="tlm-row"><div><strong>{{ order.name|default('Upcoming project') }}</strong><span>{{ order.event_date|date('M j, Y') }}{% if order.start_time %} · {{ order.start_time|date('g:i A') }}{% endif %}</span></div><a class="tlm-link" href="{{ path('panel/planner-hub/orders/orders/suborders') }}?id={{ order.id }}">Details</a></div>{% else %}<div class="tlm-empty">No private activities are scheduled yet. Public events remain available in the events calendar.</div>{% endfor %}</div><aside class="tlm-callout"><span class="tlm-kicker">Need a starting point?</span><h3>Bring us the business problem.</h3><p>You do not need to arrive with a tool selected. Start with the bottleneck, missed opportunity or decision you need to improve.</p><a class="tlm-btn primary" href="{{ path('support') }}">Ask for guidance</a></aside></section>
</div></main>
{% endblock %}
