{% extends 'templates/base.twig' %}
{% block title %}Member Dashboard | Tech Lab Miami{% endblock %}
{% block styles %}<style>
:root{--tl-bg:#070b18;--tl-panel:#0c1230;--tl-line:#26305c;--tl-cyan:#02d7ea;--tl-violet:#6d4aff;--tl-text:#f7f8ff;--tl-muted:#aeb9dc}.tl-dashboard{min-height:100vh;background:var(--tl-bg);color:var(--tl-text);padding:clamp(24px,5vw,64px) 18px}.tl-wrap{max-width:1180px;margin:auto}.tl-top{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:28px}.tl-eyebrow{color:var(--tl-cyan);font-weight:900;letter-spacing:.12em;font-size:.75rem}.tl-dashboard h1{font-size:clamp(2.2rem,6vw,4.8rem);line-height:.95;margin:.15em 0}.tl-dashboard h2{font-size:clamp(1.35rem,3vw,2rem);margin:0 0 16px}.tl-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:18px}.tl-card{grid-column:span 4;background:linear-gradient(145deg,var(--tl-panel),#10183d);border:1px solid var(--tl-line);border-radius:22px;padding:22px;min-width:0}.tl-card.wide{grid-column:span 8}.tl-card.full{grid-column:1/-1}.tl-card h3{margin:10px 0 8px}.tl-card p{color:var(--tl-muted);line-height:1.55}.tl-action{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:999px;background:var(--tl-violet);color:#fff!important;padding:11px 17px;text-decoration:none;font-weight:850;cursor:pointer}.tl-action.alt{background:transparent;border:1px solid var(--tl-cyan);color:var(--tl-cyan)!important}.tl-tag{display:inline-block;border-radius:999px;background:#19224d;color:#cdd6ff;padding:6px 10px;font-size:.72rem;font-weight:800}.tl-media{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:16px;background:#111936}.tl-list{display:grid;gap:12px}.tl-row{display:flex;justify-content:space-between;align-items:center;gap:16px;border-top:1px solid var(--tl-line);padding-top:14px}.tl-date{color:var(--tl-cyan);font-weight:800}.tl-modal{position:fixed;inset:0;background:#02040dcc;display:none;place-items:center;padding:18px;z-index:9999}.tl-modal.open{display:grid}.tl-dialog{width:min(620px,100%);background:var(--tl-panel);border:1px solid var(--tl-line);border-radius:24px;padding:25px}.tl-dialog input,.tl-dialog select,.tl-dialog textarea{width:100%;border:1px solid #394678;background:#080d22;color:#fff;border-radius:12px;padding:12px;margin:7px 0 14px}.tl-progress{height:5px;background:#20294f;border-radius:9px;overflow:hidden}.tl-progress span{display:block;height:100%;background:var(--tl-cyan)}.tl-tool-result{font-size:1.6rem;font-weight:900;color:var(--tl-cyan);min-height:38px}@media(max-width:850px){.tl-card,.tl-card.wide{grid-column:1/-1}.tl-top{display:block}.tl-row{align-items:flex-start;flex-direction:column}}
</style>{% endblock %}
{% block body %}<main class="tl-dashboard"><div class="tl-wrap">
<header class="tl-top"><div><div class="tl-eyebrow">MEMBER WORKSPACE</div><h1>Welcome, {{ user.name }}</h1></div><a class="tl-action alt" href="{{ path('logout') }}">Sign out</a></header>
<div class="tl-grid">
{% if recording %}<section class="tl-card full"><span class="tl-tag">NEXT RECORDING</span><h2>{{ recording.title }}</h2><p class="tl-date">{{ recording.starts_at|date('D, M j · g:i A') }} · {{ recording.location_name ?: 'Details shared after confirmation' }}</p><button class="tl-action" data-request="GUEST">Apply to be a guest</button></section>
{% elseif episode %}<section class="tl-card full"><span class="tl-tag">LATEST EPISODE</span><h2>{{ episode.title }}</h2><a class="tl-action" href="{{ episode.media_url ?: path('shows') }}">Watch episode</a></section>{% endif %}

{% if software %}<section class="tl-card wide"><h2>Your software</h2><div class="tl-list">{% for item in software %}<article class="tl-row"><div><span class="tl-tag">{{ item.product_status|replace({'_':' '}) }}</span><h3>{{ item.name }}</h3><p>{{ item.short_description }}</p>{% if item.show_expiry %}<small>{{ item.days_remaining }} days of included access remain through {{ item.expires_at|date('M j, Y') }}</small>{% endif %}</div>{% if item.product_status != 'COMING_SOON' %}<a class="tl-action" href="{{ path(item.access_url|trim('/')) }}">{{ item.entitlement_status == 'ACTIVE' ? 'Open' : (item.entitlement_status == 'EXPIRED' ? 'View workspace' : 'Activate') }} →</a>{% endif %}</article>{% endfor %}</div></section>{% endif %}

<section class="tl-card"><h2>Member tools</h2><p>Run practical estimates here and save the result to your account.</p><button class="tl-action alt" data-tool="event-budget">Quick budget</button> <button class="tl-action alt" data-tool="space-capacity">Quick capacity</button><div class="tl-list" style="margin-top:18px"><a href="{{ path('event-budget-calculator') }}">Full event budget calculator →</a><a href="{{ path('party-size-and-space-calculator') }}">Party size and space →</a><a href="{{ path('event-drink-calculator') }}">Drinks and cocktails →</a><a href="{{ path('finger-food-appetizer-and-meal-event-calculator') }}">Food quantities →</a><a href="{{ path('bar-calculator-for-parties-and-venues') }}">Event staffing →</a><a href="{{ path('tent-and-seating-calculator-vnv-events') }}">Tent and seating →</a><a href="{{ path('dj-sound-system-requirements-calculator') }}">Sound requirements →</a></div></section>

{% if events %}<section class="tl-card wide"><h2>Upcoming events</h2><div class="tl-list">{% for event in events %}<article class="tl-row"><div><div class="tl-date">{{ event.start_date|date('M j · g:i A') }}</div><h3>{{ event.name }}</h3><p>{{ event.location ?: 'Location announced to registered members' }}</p></div><div>{% if event.is_registered %}<span class="tl-tag">REGISTERED</span>{% elseif event.ticket_sales_enabled %}<a class="tl-action" href="{{ path('tickets') }}?event_id={{ event.id }}">Buy tickets</a>{% else %}<button class="tl-action" data-rsvp="{{ event.id }}">RSVP</button>{% endif %}</div></article>{% endfor %}</div></section>{% endif %}

{% if tickets %}<section class="tl-card"><h2>Your tickets</h2><div class="tl-list">{% for ticket in tickets|slice(0,3) %}<div><strong>{{ ticket.event_name }}</strong><p>{{ ticket.quantity }} × {{ ticket.ticket_type_name }} · {{ ticket.payment_status }}</p></div>{% endfor %}</div></section>{% endif %}

{% if episode %}<section class="tl-card"><h2>Latest episode</h2>{% if episode.thumbnail_url %}<img class="tl-media" src="{{ episode.thumbnail_url }}" alt="{{ episode.title }}" loading="lazy">{% endif %}<h3>{{ episode.title }}</h3><a class="tl-action alt" href="{{ episode.media_url ?: path('shows') }}">Play recording</a></section>{% endif %}

{% if articles %}<section class="tl-card full"><h2>Featured insights</h2><div class="tl-grid">{% for article in articles %}<a class="tl-card" href="{{ path('blog/' ~ article.slug) }}" style="color:inherit;text-decoration:none">{% if article.featured_image_url %}<img class="tl-media" src="{{ article.featured_image_url }}" alt="" loading="lazy">{% endif %}<span class="tl-tag">{{ article.category_name }}</span><h3>{{ article.title }}</h3></a>{% endfor %}</div></section>{% endif %}

<section class="tl-card full"><h2>Talk to a consultant</h2><div class="tl-row"><div><strong>Jonathan · Business, product and operations</strong><p>Turn an operating problem into a workable next step.</p></div><button class="tl-action alt" data-request="CONSULTANT">Start a consultation</button></div><div class="tl-row"><div><strong>Lucas · Engineering, martech and data</strong><p>Clarify the technical path before committing resources.</p></div><button class="tl-action alt" data-request="CONSULTANT">Start a consultation</button></div><button class="tl-action" style="margin-top:18px" data-request="SPONSOR">Become a sponsor</button></section>
</div></div></main>

<div class="tl-modal" id="request-modal" role="dialog" aria-modal="true" aria-labelledby="request-title"><div class="tl-dialog"><button class="tl-action alt" data-close style="float:right">Close</button><h2 id="request-title">Member request</h2><div class="tl-progress"><span id="request-progress" style="width:25%"></span></div><form id="request-form"><input type="hidden" name="request_type"><div data-step="1"><label>What would you like us to know?</label><textarea name="context" required rows="5"></textarea></div><div data-step="2" hidden><label>Industry</label><input name="industry" required><label>City</label><input name="city" required></div><div data-step="3" hidden><label>What operating problem are you facing?</label><textarea name="problem" required rows="5"></textarea></div><div data-step="4" hidden><label>Best availability</label><input name="availability" required></div><div style="display:flex;gap:10px;justify-content:flex-end"><button type="button" class="tl-action alt" id="request-back">Back</button><button type="button" class="tl-action" id="request-next">Continue</button></div></form><p id="request-confirmation" hidden>Your request is in. The team will review it and follow up with the next appropriate step.</p></div></div>
<div class="tl-modal" id="tool-modal" role="dialog" aria-modal="true" aria-labelledby="tool-title"><div class="tl-dialog"><button class="tl-action alt" data-close style="float:right">Close</button><h2 id="tool-title">Calculator</h2><form id="tool-form"><label>People</label><input type="number" name="people" min="1" required><label>Hours or square feet</label><input type="number" name="basis" min="1" required><label>Cost per person (budget only)</label><input type="number" name="rate" min="0" step=".01" value="25"><div class="tl-tool-result" id="tool-result"></div><button class="tl-action" type="submit">Calculate and save</button></form></div></div>
<script>
(()=>{const drafts={{ requestDrafts|json_encode|raw }};const post=async data=>{const body=new URLSearchParams(data);const r=await fetch(location.pathname,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest'},body});return r.json()};let step=1,type='',payload={};const modal=document.querySelector('#request-modal'),form=document.querySelector('#request-form');document.querySelectorAll('[data-request]').forEach(b=>b.onclick=()=>{type=b.dataset.request;const draft=drafts.find(d=>d.request_type===type);payload=draft?JSON.parse(draft.payload_json||'{}'):{};step=draft?Math.min(4,+draft.current_step+1):1;form.reset();Object.entries(payload).forEach(([key,value])=>{if(form.elements[key])form.elements[key].value=value});form.request_type.value=type;form.hidden=false;document.querySelector('#request-confirmation').hidden=true;modal.classList.add('open');show()});document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>b.closest('.tl-modal').classList.remove('open'));const show=()=>{form.querySelectorAll('[data-step]').forEach(x=>x.hidden=+x.dataset.step!==step);document.querySelector('#request-progress').style.width=(step*25)+'%';document.querySelector('#request-back').disabled=step===1};document.querySelector('#request-back').onclick=()=>{if(step>1){step--;show()}};document.querySelector('#request-next').onclick=async()=>{const current=form.querySelector('[data-step="'+step+'"]');if(![...current.querySelectorAll('[required]')].every(x=>x.reportValidity()))return;payload={...payload,...Object.fromEntries(new FormData(form))};await post({action:step===4?'submit_request':'save_request',request_type:type,step,payload:JSON.stringify(payload)});if(step===4){form.hidden=true;document.querySelector('#request-confirmation').hidden=false}else{step++;show()}};show();let tool='';const tm=document.querySelector('#tool-modal'),tf=document.querySelector('#tool-form');document.querySelectorAll('[data-tool]').forEach(b=>b.onclick=()=>{tool=b.dataset.tool;document.querySelector('#tool-title').textContent=tool==='event-budget'?'Event budget estimator':'Space capacity estimator';tm.classList.add('open')});tf.onsubmit=async e=>{e.preventDefault();const input=Object.fromEntries(new FormData(tf));const result=tool==='event-budget'?{estimate:(+input.people)*(+input.rate)}:{comfortable_capacity:Math.max(1,Math.floor((+input.basis)/15))};document.querySelector('#tool-result').textContent=tool==='event-budget'?'Estimated baseline: $'+result.estimate.toFixed(2):'Comfortable estimate: '+result.comfortable_capacity+' people';await post({action:'save_tool',tool_key:tool,input:JSON.stringify(input),result:JSON.stringify(result)})};document.querySelectorAll('[data-rsvp]').forEach(b=>b.onclick=async()=>{await post({action:'rsvp',event_id:b.dataset.rsvp});location.reload()});document.addEventListener('keydown',e=>{if(e.key==='Escape')document.querySelectorAll('.tl-modal.open').forEach(x=>x.classList.remove('open'))})})();
</script>{% endblock %}
