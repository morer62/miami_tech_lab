 <script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"Tech Lab Miami","url":"https://techlabmiami.com","description":"Miami's community for technology, AI, software and business innovation.","founder":[{"@type":"Person","name":"Jonathan Moreno"},{"@type":"Person","name":"Lucas Alvarado"}]}</script>
</head>
<body>
 <div class="brand-mobile-appbar" aria-label="Tech Lab Miami mobile navigation">
  <button class="brand-mobile-menu" type="button" aria-label="Open menu" aria-expanded="false" data-brand-mobile-toggle><span></span><span></span></button>
  <a class="brand-mobile-call" href="tel:+13052045427">☎ Call</a>
  <a class="brand-mobile-primary" href="{{ path('signup') }}">Join free</a>
 </div>
 <div class="brand-mobile-drawer" data-brand-mobile-drawer><div class="brand-mobile-drawer__brand"><img src="{{ asset_for('assets/miami-tech-lab/mark.png') }}" alt=""><span>Tech Lab Miami</span></div><nav aria-label="Tech Lab Miami menu"><a href="{{ path('shows') }}">Shows</a><a href="https://www.youtube.com/@tech-lab-miami" target="_blank" rel="noopener noreferrer">Recordings ↗</a><a href="{{ path('events') }}">Events</a><a href="{{ path('software') }}">Software</a><a href="{{ path('blog') }}">Insights</a><a href="{{ path('community') }}">Community</a><a href="{{ path('login') }}">Sign in</a></nav><div class="brand-mobile-socials" aria-label="Tech Lab Miami social media"><a href="https://www.instagram.com/tech_lab_miami" target="_blank" rel="noopener noreferrer" aria-label="Instagram">IG</a><a href="https://www.facebook.com/tech.lab.miami" target="_blank" rel="noopener noreferrer" aria-label="Facebook">f</a><a href="https://www.youtube.com/@tech-lab-miami" target="_blank" rel="noopener noreferrer" aria-label="YouTube">▶</a><a href="https://www.linkedin.com/company/tech-lab-miami/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">in</a></div></div>
 <header class="nav-shell">
  <a class="brand" href="{{ path('') }}"><img src="{{ asset_for('assets/miami-tech-lab/mark.png') }}" alt=""><span>MIAMI<br><b>TECH LAB</b></span></a>
  <button class="menu-button" aria-label="Open navigation" aria-expanded="false">Menu</button>
  <nav class="nav" aria-label="Main navigation"><a href="{{ path('shows') }}">Shows</a><a href="{{ path('events') }}">Events</a><a href="{{ path('software') }}">Software</a><a href="{{ path('blog') }}">Insights</a><a href="{{ path('community') }}">Community</a></nav>
  <div class="nav-actions"><div class="header-socials" aria-label="Tech Lab Miami social media"><a href="https://www.instagram.com/tech_lab_miami" target="_blank" rel="noopener noreferrer" aria-label="Instagram">IG</a><a href="https://www.facebook.com/tech.lab.miami" target="_blank" rel="noopener noreferrer" aria-label="Facebook">f</a><a href="https://www.youtube.com/@tech-lab-miami" target="_blank" rel="noopener noreferrer" aria-label="YouTube">▶</a><a href="https://www.linkedin.com/company/tech-lab-miami/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">in</a></div><a class="text-link" href="{{ path('login') }}">Sign in</a><a class="button small" href="{{ path('signup') }}">Join free</a></div>
 </header>

 {% if section == 'home' %}
 <main>
  <section class="hero wrap">
   <div class="hero-copy"><span class="eyebrow">Built in Miami · Built for builders</span><h1>Where technology meets <em>real business.</em></h1><p>Miami’s community for technology, AI, software and business innovation—created by operators who build, ship and execute.</p><div class="hero-actions"><a class="button" href="{{ path('signup') }}">Create free account <span>→</span></a><a class="button ghost" href="{{ path('now') }}">See what’s happening</a></div><div class="trust"><span>Shows</span><i></i><span>Events</span><i></i><span>Software</span><i></i><span>Community</span></div></div>
   <div class="hero-visual"><div class="orb"></div><img src="{{ asset_for('assets/miami-tech-lab/mark.png') }}" alt="Tech Lab Miami"><div class="signal one"><b>LIVE</b><span>Local Tech Lab</span></div><div class="signal two"><b>NEW</b><span>AI tools for operators</span></div></div>
  </section>
  <section class="live-grid wrap"><article class="feature dark"><span class="eyebrow cyan">Next show</span><h2>Local Tech Lab</h2><p>Technology, AI and tools for local businesses—without the hype.</p><div class="date"><strong>22</strong><span>AUG<br>7:00 PM</span></div><a href="{{ path('shows/local-tech-lab') }}">View the show →</a></article><article class="feature"><span class="eyebrow">Next networking</span><h2>AI & Business Night</h2><p>Founders, developers and operators in one useful room.</p><a href="{{ path('events/upcoming') }}">Reserve your place →</a></article><article class="feature software"><span class="eyebrow">Latest software</span><h2>AI Proposal Builder</h2><p>Turn a qualified opportunity into a structured proposal.</p><a href="{{ path('software/ai-proposal-builder') }}">Explore the app →</a></article></section>
  <section class="manifesto wrap"><span class="eyebrow">The platform</span><h2>Not another “tech community.”<br><em>An ecosystem that moves.</em></h2><p>Watch the conversation. Meet the people. Learn the system. Use the software. Build the next opportunity.</p></section>
  <section class="pillars wrap"><a href="{{ path('shows') }}"><span>01</span><h3>Shows</h3><p>Honest conversations with people doing the work.</p><b>Watch and listen →</b></a><a href="{{ path('events') }}"><span>02</span><h3>Events</h3><p>Networking and education designed around useful outcomes.</p><b>Find the next room →</b></a><a href="{{ path('software') }}"><span>03</span><h3>Software</h3><p>Small, focused applications made for real workflows.</p><b>Open the marketplace →</b></a><a href="{{ path('community') }}"><span>04</span><h3>Community</h3><p>Profiles, companies, opportunities and private access.</p><b>Meet the network →</b></a></section>
  <section class="showcase"><div class="wrap split"><div><span class="eyebrow cyan">Flagship show</span><h2>Local Tech Lab</h2><p class="large">AI is changing local business. We separate useful systems from expensive noise.</p><div class="tag-row"><span>Artificial Intelligence</span><span>Automation</span><span>Software</span><span>Operations</span></div><a class="button light" href="https://www.youtube.com/@tech-lab-miami" target="_blank" rel="noopener noreferrer">Watch on YouTube ↗</a></div><div class="screen"><div class="screen-top"><i></i><i></i><i></i><span>TECH LAB MIAMI / LIVE</span></div><div class="screen-body"><img src="{{ asset_for('assets/miami-tech-lab/mark.png') }}" alt=""><b>BUILT BY OPERATORS,<br>NOT INFLUENCERS.</b></div></div></div></section>
  <section class="youtube-lab"><div class="wrap"><div class="youtube-lab__head"><div><span class="eyebrow cyan">Signal over noise</span><h2>Inside the Lab.</h2><p>Short, practical conversations for people building businesses with technology.</p></div><a class="youtube-channel" href="https://www.youtube.com/@tech-lab-miami" target="_blank" rel="noopener noreferrer"><span>▶</span> Subscribe on YouTube ↗</a></div><div class="episode-wall"><a class="episode-card episode-card--lead" href="https://www.youtube.com/watch?v=HcRvyQYdQW0" target="_blank" rel="noopener noreferrer"><img src="https://i.ytimg.com/vi/HcRvyQYdQW0/hq720.jpg" alt="Is AI Stealing Your Website Content episode thumbnail" loading="lazy"><span class="episode-card__play">▶</span><div><small>LOCAL TECH LAB · 7:59</small><h3>Is AI Stealing Your Website Content?</h3><p>How large language models crawl and reuse business content.</p></div></a><a class="episode-card" href="https://www.youtube.com/watch?v=l0y0GEIMzKQ" target="_blank" rel="noopener noreferrer"><img src="https://i.ytimg.com/vi/l0y0GEIMzKQ/hq720.jpg" alt="Why You Are Getting Garbage Answers from AI episode thumbnail" loading="lazy"><span class="episode-card__play">▶</span><div><small>LOCAL TECH LAB · 9:35</small><h3>Why You’re Getting “Garbage” Answers from AI</h3><p>And the practical changes that produce better results.</p></div></a><a class="episode-card episode-card--channel" href="https://www.youtube.com/@tech-lab-miami" target="_blank" rel="noopener noreferrer"><div class="episode-card__signal">TL<span>MIAMI</span></div><div><small>THE CHANNEL</small><h3>New sessions. Real operating lessons.</h3><p>Watch the full archive and follow the next release.</p><b>Enter YouTube ↗</b></div></a></div></div></section>
  <section class="community-proof wrap"><div><span class="eyebrow">Why join</span><h2>One account.<br>More useful access.</h2><p>Membership begins free and grows with your participation.</p></div><div class="benefit-list"><a href="{{ path('events') }}"><b>01</b><span><strong>Attend</strong>Community events, recordings and practical workshops.</span></a><a href="{{ path('software') }}"><b>02</b><span><strong>Use</strong>Software, calculators and member-only utilities.</span></a><a href="{{ path('community') }}"><b>03</b><span><strong>Connect</strong>With founders, developers, operators and companies.</span></a><a href="{{ path('benefits') }}"><b>04</b><span><strong>Access</strong>Private offers, beta tools and partner benefits.</span></a></div></section>
  <section class="founders wrap"><div class="section-head"><div><span class="eyebrow">The founders</span><h2>Two disciplines.<br>One operating system.</h2></div><a href="{{ path('people') }}">Meet the people →</a></div><div class="founder-grid"><article><span>BUSINESS · PRODUCT · OPERATIONS</span><h3>Jonathan Moreno</h3><p>Twenty years across technology, entrepreneurship, project management, live production and operational execution.</p><a href="https://jonnys.media" target="_blank" rel="noopener">Jonathan’s work ↗</a></article><article><span>ENGINEERING · MARTECH · DATA</span><h3>Lucas Alvarado</h3><p>Senior developer and digital project leader focused on web infrastructure, CRM, analytics, security and growth systems.</p><a href="https://lukitdev.com" target="_blank" rel="noopener">Lucas’s work ↗</a></article></div></section>
  <section class="join"><div class="wrap"><span class="eyebrow cyan">The next connection starts here</span><h2>Build with Miami.</h2><p>Create a free profile and enter an ecosystem designed around useful people, software and ideas.</p><a class="button light" href="{{ path('signup') }}">Join Tech Lab Miami</a></div></section>
 </main>
 {% elseif section == 'shows' %}
 <main>
 {% if show %}
  <section class="page-hero wrap show-detail"><div><span class="eyebrow">Tech Lab Miami / Shows</span><h1>{{ show.title }}</h1><p>{{ show.tagline ?: show.description }}</p><div class="hero-actions"><a class="button" href="#episodes">Browse episodes</a><a class="button ghost" href="{{ path('shows') }}">All shows</a></div></div>{% if show.cover_image_url %}<img src="{{ show.cover_image_url }}" alt="{{ show.title }} cover">{% else %}<img src="{{ asset_for('assets/miami-tech-lab/mark.png') }}" alt="">{% endif %}</section>
  <section class="content-section wrap" id="episodes"><div class="section-head"><div><span class="eyebrow">Latest episodes</span><h2>Watch, listen and learn.</h2></div></div><div class="content-grid">{% for episode in show.episodes %}<article><span class="content-kicker">Episode {{ episode.episode_number ?: loop.revindex }}</span><h3>{{ episode.title }}</h3><p>{{ episode.summary }}</p>{% if episode.media_url %}<a href="{{ episode.media_url }}" rel="noopener">Open episode →</a>{% endif %}{% if episode.transcript_status == 'PUBLISHED' and episode.transcript_text %}<details><summary>Read transcript</summary><div class="transcript">{{ episode.transcript_text|nl2br }}</div></details>{% endif %}</article>{% else %}<p class="empty-state">No published episodes yet.</p>{% endfor %}</div></section>
  <section class="content-section wrap"><div class="section-head"><div><span class="eyebrow">Recording calendar</span><h2>Join the next conversation.</h2></div><a href="https://www.youtube.com/@tech-lab-miami" target="_blank" rel="noopener noreferrer">Watch recordings on YouTube ↗</a></div><div class="schedule-list">{% for recording in show.recordings %}<article><time datetime="{{ recording.starts_at }}">{{ recording.starts_at|date('M j, Y · g:i A') }}</time><div><h3>{{ recording.title }}</h3><p>{{ recording.location_name }}{% if recording.access_level != 'PUBLIC' %} · {{ recording.access_level|title }} access{% endif %}</p></div></article>{% else %}<p class="empty-state">The next recording date will be announced soon. <a href="https://www.youtube.com/@tech-lab-miami" target="_blank" rel="noopener noreferrer">Watch the current archive ↗</a></p>{% endfor %}</div></section>
  {% if show.guests %}<section class="content-section wrap"><div class="section-head"><div><span class="eyebrow">Guests</span><h2>People doing the work.</h2></div></div><div class="content-grid guests">{% for guest in show.guests %}<article>{% if guest.photo_url %}<img src="{{ guest.photo_url }}" alt="{{ guest.name }}">{% endif %}<h3>{{ guest.name }}</h3><p>{{ guest.role_title }}{% if guest.company %} · {{ guest.company }}{% endif %}</p><p>{{ guest.bio }}</p>{% if guest.profile_url %}<a href="{{ guest.profile_url }}" rel="noopener">Profile →</a>{% endif %}</article>{% endfor %}</div></section>{% endif %}
 {% else %}
  <section class="page-hero wrap"><div><span class="eyebrow">Tech Lab Miami / Shows</span><h1>{{ page[1] }}</h1><p>{{ page[2] }}</p><div class="hero-actions"><a class="button" href="{{ path('signup') }}">Join free</a><a class="button ghost" href="{{ path('now') }}">See what’s happening</a></div></div><img src="{{ asset_for('assets/miami-tech-lab/mark.png') }}" alt=""></section>
  <section class="content-section wrap"><div class="content-grid shows-grid">{% for item in shows %}<article>{% if item.cover_image_url %}<img src="{{ item.cover_image_url }}" alt="{{ item.title }} cover">{% endif %}<span class="content-kicker">{{ item.episode_count }} episode{{ item.episode_count == 1 ? '' : 's' }}</span><h2>{{ item.title }}</h2><p>{{ item.tagline ?: item.description }}</p>{% if item.next_recording_at %}<time>Next recording: {{ item.next_recording_at|date('M j · g:i A') }}</time>{% endif %}<a href="{{ path('shows/' ~ item.slug) }}">Explore the show →</a></article>{% else %}<p class="empty-state">{{ contentWarning ?: 'New shows are being prepared. Check back soon.' }}</p>{% endfor %}</div></section>
 {% endif %}
 </main>
 {% else %}
 <main><section class="page-hero wrap"><div><span class="eyebrow">Tech Lab Miami / {{ page[0] }}</span><h1>{{ page[1] }}</h1><p>{{ page[2] }}</p><div class="hero-actions"><a class="button" href="{{ path('signup') }}">Join free</a><a class="button ghost" href="{{ path('now') }}">See what’s happening</a></div></div><img src="{{ asset_for('assets/miami-tech-lab/mark.png') }}" alt=""></section><section class="route-grid wrap">{% for item in page[3] %}<article><span>0{{ loop.index }}</span><h2>{{ item }}</h2><p>{{ page[2] }}</p><a href="#updates">Explore {{ item }} →</a></article>{% endfor %}</section><section id="updates" class="updates wrap"><div><span class="eyebrow">Built to stay current</span><h2>This area grows with every release, event and conversation.</h2></div><p>Member profiles, publishing tools and the shared operational platform connect each section to the same Tech Lab Miami account.</p></section></main>
 {% endif %}
 <footer><div class="wrap footer-grid"><div class="footer-brand"><a class="brand" href="{{ path('') }}"><img src="{{ asset_for('assets/miami-tech-lab/mark.png') }}" alt=""><span>MIAMI<br><b>TECH LAB</b></span></a><p>Technology × Entrepreneurship × Operations</p><div class="footer-socials" aria-label="Tech Lab Miami social media"><a href="https://www.instagram.com/tech_lab_miami" target="_blank" rel="noopener noreferrer" aria-label="Instagram">IG</a><a href="https://www.facebook.com/tech.lab.miami" target="_blank" rel="noopener noreferrer" aria-label="Facebook">f</a><a href="https://www.youtube.com/@tech-lab-miami" target="_blank" rel="noopener noreferrer" aria-label="YouTube">▶</a><a href="https://www.linkedin.com/company/tech-lab-miami/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">in</a></div></div><div><b>Discover</b><a href="{{ path('shows') }}">Shows</a><a href="https://www.youtube.com/@tech-lab-miami" target="_blank" rel="noopener noreferrer">Recordings ↗</a><a href="{{ path('events') }}">Events</a><a href="{{ path('software') }}">Software</a><a href="{{ path('learn') }}">Learn</a></div><div><b>Community</b><a href="{{ path('community') }}">Members</a><a href="{{ path('directory') }}">Directory</a><a href="{{ path('benefits') }}">Benefits</a><a href="{{ path('partners') }}">Partners</a></div><div><b>Tech Lab Miami</b><a href="{{ path('people') }}">People</a><a href="{{ path('about') }}">About</a><a href="{{ path('about/roadmap') }}">Roadmap</a><a href="{{ path('now') }}">Now</a></div></div><div class="wrap legal"><span>© 2026 Tech Lab Miami. All rights reserved.</span><span><a href="{{ path('terms-and-conditions') }}">Terms</a><a href="{{ path('privacy-policy') }}">Privacy</a><a href="{{ path('support') }}">Contact</a></span></div></footer>
 <script>const b=document.querySelector('.menu-button'),n=document.querySelector('.nav');b?.addEventListener('click',()=>{const open=n.classList.toggle('open');b.setAttribute('aria-expanded',open);});const mt=document.querySelector('[data-brand-mobile-toggle]'),md=document.querySelector('[data-brand-mobile-drawer]');if(mt&&md){const close=()=>{mt.setAttribute('aria-expanded','false');md.classList.remove('is-open')};mt.addEventListener('click',()=>{const open=mt.getAttribute('aria-expanded')!=='true';mt.setAttribute('aria-expanded',String(open));md.classList.toggle('is-open',open)});md.querySelectorAll('a').forEach(link=>link.addEventListener('click',close));document.addEventListener('keydown',event=>{if(event.key==='Escape')close()})}</script>
</body></html>
