<!doctype html>
<html lang="en">
<head>
 <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
 <title>{{ section == 'home' ? 'Tech Lab Miami | Technology, AI, Software & Business Innovation' : page[0] ~ ' | Tech Lab Miami' }}</title>
 <meta name="description" content="{{ page[2] }}">
 <meta property="og:type" content="website"><meta property="og:site_name" content="Tech Lab Miami"><meta property="og:title" content="{{ page[0] }} | Tech Lab Miami"><meta property="og:description" content="{{ page[2] }}">
 <link rel="canonical" href="https://techlabmiami.com/{{ route }}"><link rel="icon" href="{{ asset_for('assets/miami-tech-lab/mark.png') }}">
 <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
 <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
