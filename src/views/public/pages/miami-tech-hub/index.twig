<!doctype html>
<html lang="en">
<head>
 <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
 <title>{{ section == 'home' ? 'Miami Tech Lab | Technology, AI, Software & Business Innovation' : page[0] ~ ' | Miami Tech Lab' }}</title>
 <meta name="description" content="{{ page[2] }}">
 <meta property="og:type" content="website"><meta property="og:site_name" content="Miami Tech Lab"><meta property="og:title" content="{{ page[0] }} | Miami Tech Lab"><meta property="og:description" content="{{ page[2] }}">
 <link rel="canonical" href="https://miamitechlab.com/{{ route }}"><link rel="icon" href="{{ asset_for('assets/miami-tech-lab/mark.png') }}">
 <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
 <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="{{ asset_for('assets/miami-tech-lab/site.css') }}">
 <script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"Miami Tech Lab","url":"https://miamitechlab.com","description":"Miami's community for technology, AI, software and business innovation.","founder":[{"@type":"Person","name":"Jonathan Moreno"},{"@type":"Person","name":"Lucas Alvarado"}]}</script>
</head>
<body>
 <div class="activity"><span class="live"></span><strong>Happening now</strong><a href="{{ path('shows/local-tech-lab') }}">Next Local Tech Lab recording</a><a href="{{ path('events/upcoming') }}">AI & Business Networking</a><a href="{{ path('software') }}">New software releases</a></div>
 <header class="nav-shell">
  <a class="brand" href="{{ path('') }}"><img src="{{ asset_for('assets/miami-tech-lab/mark.png') }}" alt=""><span>MIAMI<br><b>TECH LAB</b></span></a>
  <button class="menu-button" aria-label="Open navigation" aria-expanded="false">Menu</button>
  <nav class="nav" aria-label="Main navigation"><a href="{{ path('shows') }}">Shows</a><a href="{{ path('events') }}">Events</a><a href="{{ path('software') }}">Software</a><a href="{{ path('learn') }}">Learn</a><a href="{{ path('community') }}">Community</a><details><summary>More</summary><div class="mega"><a href="{{ path('news') }}">News<small>What we are shipping</small></a><a href="{{ path('resources') }}">Resources<small>Tools for operators</small></a><a href="{{ path('people') }}">People<small>Founders and members</small></a><a href="{{ path('directory') }}">Directory<small>Miami tech talent</small></a><a href="{{ path('partners') }}">Partners<small>Build with us</small></a><a href="{{ path('about') }}">About<small>Mission and roadmap</small></a></div></details></nav>
  <div class="nav-actions"><a class="text-link" href="{{ path('login') }}">Sign in</a><a class="button small" href="{{ path('signup') }}">Join free</a></div>
 </header>

 {% if section == 'home' %}
 <main>
  <section class="hero wrap">
   <div class="hero-copy"><span class="eyebrow">Built in Miami · Built for builders</span><h1>Where technology meets <em>real business.</em></h1><p>Miami’s community for technology, AI, software and business innovation—created by operators who build, ship and execute.</p><div class="hero-actions"><a class="button" href="{{ path('signup') }}">Create free account <span>→</span></a><a class="button ghost" href="{{ path('now') }}">See what’s happening</a></div><div class="trust"><span>Shows</span><i></i><span>Events</span><i></i><span>Software</span><i></i><span>Community</span></div></div>
   <div class="hero-visual"><div class="orb"></div><img src="{{ asset_for('assets/miami-tech-lab/mark.png') }}" alt="Miami Tech Lab"><div class="signal one"><b>LIVE</b><span>Local Tech Lab</span></div><div class="signal two"><b>NEW</b><span>AI tools for operators</span></div></div>
  </section>
  <section class="live-grid wrap"><article class="feature dark"><span class="eyebrow cyan">Next show</span><h2>Local Tech Lab</h2><p>Technology, AI and tools for local businesses—without the hype.</p><div class="date"><strong>22</strong><span>AUG<br>7:00 PM</span></div><a href="{{ path('shows/local-tech-lab') }}">View the show →</a></article><article class="feature"><span class="eyebrow">Next networking</span><h2>AI & Business Night</h2><p>Founders, developers and operators in one useful room.</p><a href="{{ path('events/upcoming') }}">Reserve your place →</a></article><article class="feature software"><span class="eyebrow">Latest software</span><h2>AI Proposal Builder</h2><p>Turn a qualified opportunity into a structured proposal.</p><a href="{{ path('software/ai-proposal-builder') }}">Explore the app →</a></article></section>
  <section class="manifesto wrap"><span class="eyebrow">The platform</span><h2>Not another “tech community.”<br><em>An ecosystem that moves.</em></h2><p>Watch the conversation. Meet the people. Learn the system. Use the software. Build the next opportunity.</p></section>
  <section class="pillars wrap"><a href="{{ path('shows') }}"><span>01</span><h3>Shows</h3><p>Honest conversations with people doing the work.</p><b>Watch and listen →</b></a><a href="{{ path('events') }}"><span>02</span><h3>Events</h3><p>Networking and education designed around useful outcomes.</p><b>Find the next room →</b></a><a href="{{ path('software') }}"><span>03</span><h3>Software</h3><p>Small, focused applications made for real workflows.</p><b>Open the marketplace →</b></a><a href="{{ path('community') }}"><span>04</span><h3>Community</h3><p>Profiles, companies, opportunities and private access.</p><b>Meet the network →</b></a></section>
  <section class="showcase"><div class="wrap split"><div><span class="eyebrow cyan">Flagship show</span><h2>Local Tech Lab</h2><p class="large">AI is changing local business. We separate useful systems from expensive noise.</p><div class="tag-row"><span>Artificial Intelligence</span><span>Automation</span><span>Software</span><span>Operations</span></div><a class="button light" href="{{ path('shows/local-tech-lab') }}">Explore episodes</a></div><div class="screen"><div class="screen-top"><i></i><i></i><i></i><span>MIAMI TECH LAB / LIVE</span></div><div class="screen-body"><img src="{{ asset_for('assets/miami-tech-lab/mark.png') }}" alt=""><b>BUILT BY OPERATORS,<br>NOT INFLUENCERS.</b></div></div></div></section>
  <section class="community-proof wrap"><div><span class="eyebrow">Why join</span><h2>One account.<br>More useful access.</h2><p>Membership begins free and grows with your participation.</p></div><div class="benefit-list"><a href="{{ path('events') }}"><b>01</b><span><strong>Attend</strong>Community events, recordings and practical workshops.</span></a><a href="{{ path('software') }}"><b>02</b><span><strong>Use</strong>Software, calculators and member-only utilities.</span></a><a href="{{ path('community') }}"><b>03</b><span><strong>Connect</strong>With founders, developers, operators and companies.</span></a><a href="{{ path('benefits') }}"><b>04</b><span><strong>Access</strong>Private offers, beta tools and partner benefits.</span></a></div></section>
  <section class="founders wrap"><div class="section-head"><div><span class="eyebrow">The founders</span><h2>Two disciplines.<br>One operating system.</h2></div><a href="{{ path('people') }}">Meet the people →</a></div><div class="founder-grid"><article><span>BUSINESS · PRODUCT · OPERATIONS</span><h3>Jonathan Moreno</h3><p>Twenty years across technology, entrepreneurship, project management, live production and operational execution.</p><a href="https://jonnys.media" target="_blank" rel="noopener">Jonathan’s work ↗</a></article><article><span>ENGINEERING · MARTECH · DATA</span><h3>Lucas Alvarado</h3><p>Senior developer and digital project leader focused on web infrastructure, CRM, analytics, security and growth systems.</p><a href="https://lukitdev.com" target="_blank" rel="noopener">Lucas’s work ↗</a></article></div></section>
  <section class="join"><div class="wrap"><span class="eyebrow cyan">The next connection starts here</span><h2>Build with Miami.</h2><p>Create a free profile and enter an ecosystem designed around useful people, software and ideas.</p><a class="button light" href="{{ path('signup') }}">Join Miami Tech Lab</a></div></section>
 </main>
 {% else %}
 <main><section class="page-hero wrap"><div><span class="eyebrow">Miami Tech Lab / {{ page[0] }}</span><h1>{{ page[1] }}</h1><p>{{ page[2] }}</p><div class="hero-actions"><a class="button" href="{{ path('signup') }}">Join free</a><a class="button ghost" href="{{ path('now') }}">See what’s happening</a></div></div><img src="{{ asset_for('assets/miami-tech-lab/mark.png') }}" alt=""></section><section class="route-grid wrap">{% for item in page[3] %}<article><span>0{{ loop.index }}</span><h2>{{ item }}</h2><p>{{ page[2] }}</p><a href="#updates">Explore {{ item }} →</a></article>{% endfor %}</section><section id="updates" class="updates wrap"><div><span class="eyebrow">Built to stay current</span><h2>This area grows with every release, event and conversation.</h2></div><p>Member profiles, publishing tools and the shared operational platform connect each section to the same Miami Tech Lab account.</p></section></main>
 {% endif %}
 <footer><div class="wrap footer-grid"><div class="footer-brand"><a class="brand" href="{{ path('') }}"><img src="{{ asset_for('assets/miami-tech-lab/mark.png') }}" alt=""><span>MIAMI<br><b>TECH LAB</b></span></a><p>Technology × Entrepreneurship × Operations</p></div><div><b>Discover</b><a href="{{ path('shows') }}">Shows</a><a href="{{ path('events') }}">Events</a><a href="{{ path('software') }}">Software</a><a href="{{ path('learn') }}">Learn</a></div><div><b>Community</b><a href="{{ path('community') }}">Members</a><a href="{{ path('directory') }}">Directory</a><a href="{{ path('benefits') }}">Benefits</a><a href="{{ path('partners') }}">Partners</a></div><div><b>Miami Tech Lab</b><a href="{{ path('people') }}">People</a><a href="{{ path('about') }}">About</a><a href="{{ path('about/roadmap') }}">Roadmap</a><a href="{{ path('now') }}">Now</a></div></div><div class="wrap legal"><span>© 2026 Miami Tech Lab. All rights reserved.</span><span><a href="{{ path('terms-and-conditions') }}">Terms</a><a href="{{ path('privacy-policy') }}">Privacy</a><a href="{{ path('support') }}">Contact</a></span></div></footer>
 <script>const b=document.querySelector('.menu-button'),n=document.querySelector('.nav');b?.addEventListener('click',()=>{const open=n.classList.toggle('open');b.setAttribute('aria-expanded',open);});</script>
</body></html>
