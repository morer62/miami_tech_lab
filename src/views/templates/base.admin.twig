    {% block aside %}
    {% endblock %}
    {% include 'templates/components/toast-component.twig' %}

    <script src="{{ asset_for('template/js/app.js') }}"></script>
    <script src="{{ asset_for('assets/js/luxon.min.js') }}"></script>
    <script>

    </script>
    <script>

        document.addEventListener('DOMContentLoaded', () => {
            {% if alertMessage is not null %}

                {% if isMobileApp %}
                    if (window.bootstrap) {
                        new bootstrap.Toast(document.getElementById('alertToast')).show();
                    }
                {% else %}
                    setTimeout(() => {
                        alert('{{ alertMessage.message }}')
                    }, 1)
                {% endif %}
            {% endif %}

            document.querySelectorAll("[data-phone]").forEach(elm => {
                elm.addEventListener("input", function (e) {
                    let value = e.target.value.replace(/\D/g, ""); // Remove non-numeric characters

                    if (value.startsWith("1")) {
                        value = "+" + value; // Ensure +1 is kept
                    } else if (value.length > 0) {
                        value = "+1" + value; // Add +1 if not present
                    }

                    if (value.length > 2 && value.length <= 5) {
                        value = `${value.slice(0, 2)} (${value.slice(2)}`;
                    } else if (value.length > 5 && value.length <= 8) {
                        value = `${value.slice(0, 2)} (${value.slice(2, 5)}) ${value.slice(5)}`;
                    } else if (value.length > 8) {
                        value = `${value.slice(0, 2)} (${value.slice(2, 5)}) ${value.slice(5, 8)}-${value.slice(8, 12)}`;
                    }

                    e.target.value = value;
                })
            })

            document.querySelectorAll("[form-delete]").forEach(elm => {
                elm.addEventListener("submit",function (e) {
                    e.preventDefault()
                    const isConfirmed = confirm("Are you sure you want to delete this item?")
                    if (isConfirmed) {
                        this.submit()
                    }
                })
            })
        })

        document.addEventListener('DOMContentLoaded', function () {
            const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]')

            for (const tooltipTriggerEl of tooltipTriggerList) {
                new bootstrap.Tooltip(tooltipTriggerEl)
            }
        })

        document.addEventListener('DOMContentLoaded', function () {
            const { DateTime } = luxon;
            const localTimes = document.querySelectorAll('[data-local-time]')

            localTimes.forEach(elm => {

                let utcText = elm.innerText
                let utcDateTime = DateTime.fromFormat(utcText, "yyyy-MM-dd HH:mm:ss", { zone: "utc" });
                const local = utcDateTime.setZone(DateTime.local().zoneName);
                elm.innerText = local.toFormat("yyyy-MM-dd HH:mm:ss")
            })
        })

    </script>
    <script src="https://maps.googleapis.com/maps/api/js?key={{ env.GOOGLE_KEY }}&loading=async&libraries=places&callback=initMap"></script>
    <script src="{{ asset_for('assets/js/googleMaps.js') }}" ></script>
    <script src="{{ asset_for('assets/js/vnv-async-forms.js') }}"></script>

    {% block scripts %}
    {% endblock %}

    {% if show_whatsapp is defined and show_whatsapp %}
        <a href="https://wa.me/13053761210"
        class="floating-whatsapp"
        target="_blank"
        rel="noopener noreferrer">
            <i class="fa-brands fa-whatsapp"></i>
            <span>Chat with us</span>
