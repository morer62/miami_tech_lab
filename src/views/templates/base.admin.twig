    <style>
        .sidebar [data-bs-toggle=collapse]:after {
            border: solid;
            border-width: 0 .075rem .075rem 0;
            content: " ";
            display: inline-block;
            padding: 2px;
            position: absolute;
            right: 1.5rem;
            top: 1.2rem;
            transform: rotate(45deg);
            transition: all .2s ease-out;
        }

        .sidebar [aria-expanded=true]:after, .sidebar [data-bs-toggle=collapse]:not(.collapsed):after {
            top: 1.4rem;
            transform: rotate(-135deg);
        }

        .sidebar-dropdown .sidebar-link:before {
            content: "â†’";
            display: inline-block;
            left: -14px;
            position: relative;
            transform: translateX(0);
            transition: all .1s ease;
        }

        .w-fit {
            width: fit-content;
        }

        .vnv-events-sidebar {
            --vnv-side-ink: #f6f8ff;
            --vnv-side-muted: rgba(219, 226, 243, .68);
            --vnv-side-green: #16dceb;
            --vnv-side-teal: #8065ff;
            --vnv-side-deep: #080b19;
            --vnv-side-panel: rgba(255, 255, 255, .055);
            background:
                radial-gradient(circle at 15% 0%, rgba(22,220,235,.15), transparent 30%),
                linear-gradient(180deg, #10152b 0%, #0b1022 48%, #070a16 100%) !important;
            border-right: 1px solid rgba(22, 220, 235, .14);
            box-shadow: inset -1px 0 0 rgba(255,255,255,.045), 18px 0 44px rgba(0, 0, 0, .22);
        }

        .vnv-events-sidebar .sidebar-content {
            background: transparent !important;
            position: relative;
        }

        .vnv-events-sidebar .sidebar-content:before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background:
                linear-gradient(90deg, rgba(255,255,255,.032), transparent 38%),
                repeating-linear-gradient(135deg, rgba(255,255,255,.018) 0 1px, transparent 1px 18px);
            opacity: .62;
        }

        .vnv-events-sidebar .sidebar-brand {
            position: relative;
            z-index: 1;
            margin: 14px 14px 10px;
            padding: 18px 16px;
            border: 1px solid rgba(22, 220, 235, .20);
            border-radius: 22px;
            background:
                radial-gradient(circle at top right, rgba(128, 101, 255, .28), transparent 42%),
                linear-gradient(135deg, rgba(255,255,255,.10), rgba(255,255,255,.035));
            color: #fff !important;
            font-weight: 950;
            letter-spacing: -.02em;
            box-shadow: 0 18px 36px rgba(0,0,0,.18);
        }

        .vnv-events-sidebar .sidebar-brand span:before {
            content: "Tech Lab Miami";
            display: block;
            margin-bottom: 4px;
            color: var(--vnv-side-green);
            font-size: .72rem;
            font-weight: 950;
            letter-spacing: .16em;
            text-transform: uppercase;
        }

        .vnv-events-sidebar .sidebar-nav {
            position: relative;
            z-index: 1;
            padding: 4px 10px 26px;
        }

        .vnv-events-sidebar .sidebar-header {
            margin: 20px 8px 8px;
            padding: 0;
            color: var(--vnv-side-green) !important;
            font-size: .68rem;
            font-weight: 950;
            letter-spacing: .16em;
            text-transform: uppercase;
            opacity: 1;
        }

        .vnv-events-sidebar .sidebar-header:first-child {
            color: rgba(219,226,243,.48) !important;
        }

        .vnv-events-sidebar .sidebar-item {
            margin: 3px 0;
        }

        .vnv-events-sidebar .sidebar-link {
            position: relative;
            min-height: 46px;
            margin: 0;
            padding: 10px 12px;
            border: 1px solid transparent;
            border-radius: 16px;
            color: var(--vnv-side-muted) !important;
            background: transparent !important;
            font-weight: 780;
            transition: transform .16s ease, background .16s ease, border-color .16s ease, color .16s ease, box-shadow .16s ease;
        }

        .vnv-events-sidebar .sidebar-link i,
        .vnv-events-sidebar .sidebar-link svg {
            width: 18px;
            height: 18px;
            color: var(--vnv-side-green) !important;
            filter: drop-shadow(0 0 10px rgba(22, 220, 235, .24));
        }

        .vnv-events-sidebar .sidebar-link:before {
            content: "";
            width: 30px;
            height: 30px;
            position: absolute;
            left: 7px;
            top: 50%;
            transform: translateY(-50%) scale(.92);
            border-radius: 12px;
            background: rgba(22, 220, 235, .08);
            opacity: 0;
            transition: opacity .16s ease, transform .16s ease;
        }

        .vnv-events-sidebar .sidebar-link:hover,
        .vnv-events-sidebar .sidebar-item.active > .sidebar-link,
        .vnv-events-sidebar .sidebar-link[aria-expanded="true"] {
            color: var(--vnv-side-ink) !important;
            border-color: rgba(22, 220, 235, .22);
            background:
                linear-gradient(135deg, rgba(22, 220, 235, .16), rgba(128,101,255,.14)) !important;
            box-shadow: inset 0 1px 0 rgba(255,255,255,.08), 0 12px 26px rgba(0,0,0,.16);
            transform: translateX(2px);
        }

        .vnv-events-sidebar .sidebar-link:hover:before,
        .vnv-events-sidebar .sidebar-item.active > .sidebar-link:before,
        .vnv-events-sidebar .sidebar-link[aria-expanded="true"]:before {
            opacity: 1;
            transform: translateY(-50%) scale(1);
        }

        .vnv-events-sidebar .sidebar-link span {
            position: relative;
            z-index: 1;
            color: inherit !important;
        }

        .vnv-events-sidebar .sidebar-dropdown {
            margin: 4px 0 10px 18px;
            padding-left: 8px;
            border-left: 1px solid rgba(22, 220, 235, .16);
        }

        .vnv-events-sidebar .sidebar-dropdown .sidebar-link {
            min-height: 38px;
            border-radius: 13px;
            color: rgba(219,226,243,.62) !important;
            font-size: .88rem;
        }

        .vnv-events-sidebar .sidebar-dropdown .sidebar-link:before {
            display: none;
        }

        .vnv-events-sidebar .simplebar-scrollbar:before {
            background: rgba(22, 220, 235, .44);
        }

        @media (max-width: 767.98px) {
            .vnv-events-sidebar .sidebar-brand {
                margin: 12px;
            }

            .vnv-events-sidebar .sidebar-link {
                min-height: 48px;
            }
        }

        .floating-whatsapp{
            position:fixed;
            right:20px;
            bottom:20px;
            z-index:0;
            display:inline-flex;
            align-items:center;
            gap:.65rem;
            padding:.9rem 1.1rem;
            border-radius:999px;
            background:#25D366;
            color:#fff !important;
            text-decoration:none;
            font-weight:800;
            box-shadow:0 14px 30px rgba(0,0,0,.18);
            transition:transform .2s ease, box-shadow .2s ease;
        }

        .floating-whatsapp i{
            font-size:1.3rem;
        }

        .floating-whatsapp:hover{
            transform:translateY(-2px);
            box-shadow:0 18px 36px rgba(0,0,0,.22);
        }

        @media (max-width: 768px){
            .floating-whatsapp{
                right:14px;
                bottom:14px;
                width:66px;
                height:66px;
                justify-content:center;
                border-radius:50%;
                padding:0;
            }

            .floating-whatsapp span{
                display:none;
            }

            .floating-whatsapp i{
                font-size:2rem;
            }
        }

        :root{
            --bs-primary:#6d4aff;
            --bs-primary-rgb:109,74,255;
            --bs-link-color:#5138d4;
            --bs-link-hover-color:#34239b;
            --vnv-panel-primary:#16dceb;
            --vnv-panel-primary-dark:#087d89;
            --vnv-panel-accent:#8065ff;
        }

        body{background:#f4f6fb;color:#111936}
        .navbar-bg{background:#fff;border-bottom:1px solid #e2e6f0;box-shadow:0 8px 26px rgba(7,11,24,.06)}
        .btn-primary,.bg-primary{border-color:#6d4aff!important;background:#6d4aff!important;color:#fff!important}
        .btn-primary:hover,.btn-primary:focus{border-color:#5138d4!important;background:#5138d4!important;color:#fff!important}
        .btn-outline-primary{border-color:#6d4aff!important;color:#5138d4!important}
        .btn-outline-primary:hover,.btn-outline-primary.active{background:#6d4aff!important;color:#fff!important}
        .text-primary{color:#5138d4!important}
        .form-control:focus,.form-select:focus{border-color:#8065ff;box-shadow:0 0 0 .2rem rgba(109,74,255,.16)}
        .card{border-color:#e2e6f0;box-shadow:0 12px 34px rgba(20,29,59,.06)}
    </style>
    {% block style %}
    {% endblock %}


</head>

<body>

    <!-- Google Tag Manager (noscript) -->
